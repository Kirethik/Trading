[Unit]
Description=Regime-Trader API (FastAPI/uvicorn, port 8000)
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/regime-trader
EnvironmentFile=-/home/ec2-user/regime-trader/.env
ExecStart=/home/ec2-user/regime-trader/venv/bin/uvicorn regime_trader.web.app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
